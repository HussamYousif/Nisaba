# Nisaba development secrets (copy to .env and fill in — .env is gitignored)
#
# These values are injected into DEBUG builds only (BuildConfig.DEEPSEEK_API_KEY)
# and used automatically by the app when no key is entered in Settings.
# Release builds never embed them.
#
# Get a key at: https://platform.deepseek.com

DEEPSEEK_API_KEY=
