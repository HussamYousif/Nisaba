<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- reminders the notebook was asked for, when there is no calendar app (a Boox has none) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".app.NisabaApp"
        android:allowBackup="false"
        tools:replace="android:allowBackup,android:label,android:icon,android:roundIcon"
        android:label="Nisaba"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Nisaba">
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nisaba.Starting"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with Nisaba" / "Share to Nisaba" for a PDF: it becomes a notebook (after choosing who answers) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <receiver android:name="com.nisaba.device.ReminderAlarmReceiver" android:exported="false" />
    </application>
</manifest>
