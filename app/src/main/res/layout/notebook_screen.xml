<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/nbToolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/parchment_deep"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/nbBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/nb_back"
            android:contentDescription="@string/nb_back_desc"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/nbTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/nbPrev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/nb_prev_page"
            android:contentDescription="@string/nb_prev_page_desc"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/nbPageLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="48dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nbNext"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/nb_next_page"
            android:contentDescription="@string/nb_next_page_desc"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/ink_soft" />

        <TextView
            android:id="@+id/nbUndo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/nb_undo"
            android:contentDescription="@string/nb_undo_desc"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/nbRedo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/nb_redo"
            android:contentDescription="@string/nb_redo_desc"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/nbEraser"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/nb_eraser"
            android:contentDescription="@string/nb_eraser_desc"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/nbNewPage"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/nb_new_page"
            android:contentDescription="@string/nb_new_page_desc"
            android:textColor="@color/ink"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.nisaba.ui.InkScrollView
            android:id="@+id/pageScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pageScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.nisaba.ink.InkSurfaceView
                    android:id="@+id/inkView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.nisaba.ui.InkScrollView>


        <ImageButton
            android:id="@+id/quillButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/quill_button_bg"
            android:contentDescription="@string/nb_quill"
            android:src="@drawable/ic_quill"
            android:padding="14dp" />
    </FrameLayout>
</LinearLayout>
