<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/parchment_deep"
    android:padding="24dp">

    <!-- Header: title + tagline, settings tucked top-right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shelfTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shelf_title"
                android:textColor="@color/ink"
                android:textSize="46sp"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/shelfTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:text="@string/shelf_tagline"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shelfSettingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/shelf_settings"
            android:padding="10dp"
            android:text="✎"
            android:textColor="@color/ink_soft"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- The two tome actions, styled as book covers with spines -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/blankTome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/tome_action_card"
            android:padding="16dp">

            <View
                android:layout_width="6dp"
                android:layout_height="52dp"
                android:background="@drawable/spine_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/blankGlyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="@color/accent_red"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/blankTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/shelf_blank"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/blankDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shelf_blank_desc"
                    android:textColor="@color/ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pdfTome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/tome_action_card"
            android:padding="16dp">

            <View
                android:layout_width="6dp"
                android:layout_height="52dp"
                android:background="@drawable/spine_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pdfGlyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❧"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/pdfTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/shelf_tome"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pdfDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shelf_tome_desc"
                    android:textColor="@color/ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Shelf of notebooks -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelfList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/shelfEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/shelf_empty"
            android:textColor="@color/ink_soft"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
