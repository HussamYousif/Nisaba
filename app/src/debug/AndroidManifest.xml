<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest: hosts the instrumented-test activity in the app
     process and permits cleartext HTTP to local mock servers (10.0.2.2).
     Release builds keep the secure default (cleartext blocked). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:usesCleartextTraffic="true">
        <activity
            android:name="com.nisaba.ink.TestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
